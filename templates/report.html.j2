<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% include '_styles.html.j2' %}
</head>
<body>

{% set sections = include_sections | default([]) %}
{% set k = kpis | default({}) %}
{% set pace = pacing | default({}) %}

<!-- ================= COVER ================= -->
<div class="page">
  <div class="cover">
    <div class="cover-head">
      <div class="cover-brand">TRAFFIC DIGITAL SOLUTIONS</div>
      <div class="cover-mark">T</div>
    </div>
    <div>
      <div class="cover-kicker">Media Buying Performance Report</div>
      <h1 class="cover-title" style="margin-top:14px">{{ client.name | default('Client') }}</h1>
      <div class="cover-sub">{{ month_label | default('') }} &mdash; Monthly Performance</div>
      <div class="cover-rule"></div>
      <div class="cover-meta">
        <div><strong>Reporting Period:</strong> {{ date_start | default('') }} &mdash; {{ date_stop | default('') }}</div>
        <div><strong>Platforms:</strong> {{ platforms_label | default('-') }}</div>
        <div><strong>Prepared by:</strong> Traffic Digital Solutions</div>
        <div class="muted"><strong>Prepared on:</strong> {{ report_date | default('') }}</div>
      </div>
    </div>
    <div class="cover-foot">
      Confidential &middot; Prepared exclusively for {{ client.name | default('the client') }} &middot; Contains commercially sensitive performance data
    </div>
  </div>
</div>

<!-- ================= TABLE OF CONTENTS ================= -->
<div class="page">
  <h2 class="section">Table of Contents</h2>
  {% set toc_items = [] %}
  {% if 'executive_summary' in sections and (executive_summary | default('') or k) %}{% set _ = toc_items.append('Executive Summary') %}{% endif %}
  {% if 'campaign_performance' in sections and (campaigns | default([])) %}{% set _ = toc_items.append('Campaign Performance') %}{% endif %}
  {% if 'conversions' in sections and (conversions | default([])) %}{% set _ = toc_items.append('Conversion Breakdown') %}{% endif %}
  {% if 'distribution' in sections and (publishers | default([]) or devices | default([]) or countries | default([])) %}{% set _ = toc_items.append('Distribution') %}{% endif %}
  {% if 'audience' in sections and (demographics | default([]) or dow_pacing | default([]) or age_gender | default({})) %}{% set _ = toc_items.append('Audience Insights') %}{% endif %}
  {% if 'page_instagram' in sections and (reach | default([]) or messaging | default([]) or content | default([]) or audience | default([])) %}{% set _ = toc_items.append('Page & Instagram') %}{% endif %}
  {% if 'recommendations' in sections and (recommendations | default([])) %}{% set _ = toc_items.append('Recommendations') %}{% endif %}
  {% if 'appendix' in sections %}{% set _ = toc_items.append('Appendix') %}{% endif %}
  {% for item in toc_items %}
  <div class="toc-line"><span><span class="toc-num">{{ loop.index }}</span>{{ item }}</span></div>
  {% endfor %}
  {% if scope_prose %}
  <h3 class="block" style="margin-top:24px">Report Scope</h3>
  <div class="prose">{{ scope_prose }}</div>
  {% if scope_notes %}<div class="prose" style="margin-top:10px">{{ scope_notes }}</div>{% endif %}
  {% endif %}
</div>

<!-- ================= EXECUTIVE SUMMARY ================= -->
{% if 'executive_summary' in sections and (executive_summary | default('') or k) %}
<div class="page">
  <h2 class="section">Executive Summary</h2>

  {% if executive_summary %}
  <div class="exec-box">
    <h3>{{ month_label | default('') }} AT A GLANCE</h3>
    <p>{{ executive_summary }}</p>
  </div>
  {% endif %}

  {% if k %}
  <h3 class="block">Key Performance Indicators</h3>
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="label">Amount Spent</div>
      <div class="value">{{ k.spend_fmt | default('0') }}</div>
      <div class="delta">
          {% if mom.spend.delta_pct is defined and mom.spend.delta_pct is not none %}
            {% if mom.spend.delta_pct > 0 %}<span class="delta-arrow up">&#9650;</span>{% elif mom.spend.delta_pct < 0 %}<span class="delta-arrow down">&#9660;</span>{% else %}<span class="delta-arrow flat">&#9650;</span>{% endif %}
            {{ mom.spend.delta_pct | abs }}% vs prev month
          {% else %}<span class="flat">no prior data</span>{% endif %}
      </div>
    </div>
    <div class="kpi-card">
      <div class="label">Results</div>
      <div class="value">{{ k.results_fmt | default('0') }}</div>
      <div class="delta">
          {% if mom.results.delta_pct is defined and mom.results.delta_pct is not none %}
            {% if mom.results.delta_pct > 0 %}<span class="delta-arrow up">&#9650;</span>{% elif mom.results.delta_pct < 0 %}<span class="delta-arrow down">&#9660;</span>{% else %}<span class="delta-arrow flat">&#9650;</span>{% endif %}
            {{ mom.results.delta_pct | abs }}% vs prev month
          {% else %}<span class="flat">no prior data</span>{% endif %}
      </div>
    </div>
    <div class="kpi-card">
      <div class="label">Cost Per Result</div>
      <div class="value">{{ k.cpr_fmt | default('0') }}</div>
      <div class="delta">
          {% if mom.cpr.delta_pct is defined and mom.cpr.delta_pct is not none %}
            {% if mom.cpr.delta_pct > 0 %}<span class="delta-arrow down">&#9650;</span>{% elif mom.cpr.delta_pct < 0 %}<span class="delta-arrow up">&#9660;</span>{% else %}<span class="delta-arrow flat">&#9660;</span>{% endif %}
            {{ mom.cpr.delta_pct | abs }}% vs prev month
          {% else %}<span class="flat">no prior data</span>{% endif %}
      </div>
    </div>
    <div class="kpi-card">
      <div class="label">CTR</div>
      <div class="value">{{ k.ctr | default(0) }}%</div>
      <div class="delta">
          {% if mom.ctr.delta_pct is defined and mom.ctr.delta_pct is not none %}
            {% if mom.ctr.delta_pct > 0 %}<span class="delta-arrow up">&#9650;</span>{% elif mom.ctr.delta_pct < 0 %}<span class="delta-arrow down">&#9660;</span>{% else %}<span class="delta-arrow flat">&#9650;</span>{% endif %}
            {{ mom.ctr.delta_pct | abs }}% vs prev month
          {% else %}<span class="flat">no prior data</span>{% endif %}
      </div>
    </div>
    <div class="kpi-card">
      <div class="label">Impressions</div>
      <div class="value">{{ k.impressions_fmt | default('0') }}</div>
      <div class="sub">Reach: {{ k.reach_fmt | default('0') }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">Frequency</div>
      <div class="value">{{ k.frequency | default(0) }}</div>
      <div class="sub">Impressions &divide; reach</div>
    </div>
    <div class="kpi-card">
      <div class="label">CPC</div>
      <div class="value">{{ k.cpc | default(0) }}</div>
      <div class="sub">CPM: {{ k.cpm | default(0) }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">{% if k.primary_action %}{{ k.primary_action }} CPA{% else %}CPA{% endif %}</div>
      <div class="value">{{ k.cpa_primary_fmt | default('&mdash;') }}</div>
      {% if k.roas is not none %}<div class="sub">ROAS: <strong>{{ k.roas_fmt }}</strong></div>{% else %}<div class="sub">ROAS: n/a</div>{% endif %}
    </div>
  </div>

  {% if k.budget_amount_fmt %}
  <h3 class="block">Budget Utilization</h3>
  <div class="util-wrap">
    <div class="util-label">
      <span><strong>{{ k.spend_fmt | default('0') }}</strong> spent of {{ k.budget_amount_fmt | default('0') }}</span>
      <span><strong>{{ k.budget_utilization | default(0) }}%</strong> utilized</span>
    </div>
    <div class="util-track">
      <div class="util-fill {% if k.budget_utilization | default(0) > 100 %}over{% endif %}"
           style="width: {{ [k.budget_utilization | default(0), 100] | min }}%"></div>
    </div>
  </div>
  {% endif %}
  {% endif %}

  {% if anomalies %}
  <h3 class="block">Notable Findings</h3>
  <div class="anomaly-box">
    <ul>
      {% for a in anomalies %}<li>{{ a }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
{% endif %}

<!-- ================= CAMPAIGN PERFORMANCE ================= -->
{% if 'campaign_performance' in sections and (campaigns | default([])) %}
<div class="page">
  <h2 class="section">Campaign Performance</h2>
  <p class="lead muted">
    All campaigns for {{ month_label | default('') }}. MoM column shows spend change vs {{ prev_month_label | default('the previous month') }}.
  </p>
  <table>
    <thead>
      <tr>
        <th>Campaign</th>
        <th>Objective</th>
        <th>Status</th>
        <th class="num">Spend</th>
        <th class="num">Results</th>
        <th class="num">CPR</th>
        <th class="num">CTR</th>
        <th class="num">CPC</th>
        <th class="num">CPM</th>
        <th class="num">Freq</th>
        <th>Share of Spend</th>
        <th class="num">MoM</th>
      </tr>
    </thead>
    <tbody>
      {% for row in campaigns %}
      <tr class="{% if row.is_top %}row-top{% elif row.is_bottom %}row-bottom{% endif %}">
        <td>
          {{ row.name }}
          {% if row.is_top %}<span class="badge top">TOP</span>{% endif %}
          {% if row.is_bottom %}<span class="badge bottom">WEAK</span>{% endif %}
        </td>
        <td>{{ row.objective | default('-') }}</td>
        <td>{{ row.status | default('-') }}</td>
        <td class="num">{{ row.spend_fmt }}</td>
        <td class="num">{{ row.results }}</td>
        <td class="num">{{ row.cpr_fmt }}</td>
        <td class="num">{{ row.ctr }}%</td>
        <td class="num">{{ row.cpc }}</td>
        <td class="num">{{ row.cpm }}</td>
        <td class="num">{{ row.frequency }}</td>
        <td>
          <div class="share">
            <div class="share-track"><div class="share-fill" style="width: {{ row.bar_width | default(0) }}%"></div></div>
            <span class="small muted">{{ row.share_pct | default(0) }}%</span>
          </div>
        </td>
        <td class="num">
          {% if row.mom_spend_delta_pct is not none %}
            {% if row.mom_spend_delta_pct > 0 %}<span class="delta-arrow up">&#9650;</span>{% elif row.mom_spend_delta_pct < 0 %}<span class="delta-arrow down">&#9660;</span>{% endif %}
            {{ row.mom_spend_delta_pct | abs }}%
          {% else %}&mdash;{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="small muted">
    All monetary values in {{ currency | default('EGP') }}. CPR = cost per result; CTR = click-through rate;
    CPC = cost per click; CPM = cost per 1,000 impressions; Freq = average frequency.
    "TOP" marks the best performers by results, "WEAK" marks the weakest with flags on cost, frequency or zero results.
  </p>
</div>
{% endif %}

<!-- ================= CONVERSION BREAKDOWN ================= -->
{% if 'conversions' in sections and (conversions | default([])) %}
<div class="page">
  <h2 class="section">Conversion Breakdown</h2>
  <p class="lead muted">Actions tracked by Meta for the reporting period, with counts, cost and cost-per-action.</p>
  <table>
    <thead>
      <tr>
        <th>Action Type</th>
        <th class="num">Count</th>
        <th class="num">Share</th>
        <th class="num">Cost</th>
        <th class="num">Cost / Action</th>
      </tr>
    </thead>
    <tbody>
      {% for c in conversions %}
      <tr>
        <td>{{ c.label }}</td>
        <td class="num">{{ c.count }}</td>
        <td class="num">{{ c.pct }}%</td>
        <td class="num">{{ c.cost_fmt }}</td>
        <td class="num">{{ c.cpa_fmt }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <h3 class="block">Results by Action</h3>
  <div class="conv-bars">
    {% set max_count = (conversions | map(attribute='count') | max) if conversions else 1 %}
    {% for c in conversions %}
    <div class="conv-bar-row">
      <div class="conv-bar-label">{{ c.label }}</div>
      <div class="conv-bar-track"><div class="conv-bar-fill" style="width: {{ (c.count / max_count * 100) | round(1) }}%"></div></div>
      <div class="conv-bar-val">{{ c.count }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="small muted">Cost per action is derived from Meta's cost-per-action-type reporting; when unavailable it falls back to a share of spend.</p>
</div>
{% endif %}

<!-- ================= DISTRIBUTION ================= -->
{% if 'distribution' in sections and (publishers | default([]) or devices | default([]) or countries | default([])) %}
<div class="page">
  <h2 class="section">Distribution</h2>

  {% if publishers %}
  <div class="chart">
    <div class="chart-title">Spend by Publisher Platform</div>
    {% for p in publishers %}
    <div class="hbar-row">
      <div class="hbar-label">{{ p.label }}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width: {{ p.bar_width | default(0) }}%"></div></div>
      <div class="hbar-val">{{ p.spend_fmt }} &middot; {{ p.pct }}% &middot; {{ p.impressions }} imp</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if devices %}
  <div class="chart">
    <div class="chart-title">Spend by Device</div>
    {% for d in devices %}
    <div class="hbar-row">
      <div class="hbar-label">{{ d.label }}</div>
      <div class="hbar-track"><div class="hbar-fill alt" style="width: {{ d.bar_width | default(0) }}%"></div></div>
      <div class="hbar-val">{{ d.spend_fmt }} &middot; {{ d.pct }}% &middot; CTR {{ d.ctr }}%</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if countries %}
  <div class="chart">
    <div class="chart-title">Spend by Country (Top 10)</div>
    {% for c in countries %}
    <div class="hbar-row">
      <div class="hbar-label">{{ c.label }}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width: {{ c.bar_width | default(0) }}%"></div></div>
      <div class="hbar-val">{{ c.spend_fmt }} &middot; {{ c.pct }}% &middot; {{ c.results }} results</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <p class="small muted">Percentages show each bucket's share of total spend. CTR is click-through rate within the bucket.</p>
</div>
{% endif %}

<!-- ================= AUDIENCE INSIGHTS ================= -->
{% if 'audience' in sections and (demographics | default([]) or age_gender | default({}) or dow_pacing | default([]) or hour_pacing | default([])) %}
<div class="page">
  <h2 class="section">Audience Insights</h2>

  {% if age_gender %}
  <h3 class="block">Spend by Age &times; Gender</h3>
  <table>
    <thead>
      <tr><th>Age Group</th><th class="num">Female</th><th class="num">Male</th><th class="num">Total Spend</th></tr>
    </thead>
    <tbody>
      {% for age, cell in age_gender.items() %}
      <tr><td>{{ age }}</td><td class="num">{{ cell.F }}</td><td class="num">{{ cell.M }}</td><td class="num">{{ cell.total }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if demographics %}
  <h3 class="block">Top Audience Segments</h3>
  <table>
    <thead>
      <tr><th>Age</th><th>Gender</th><th class="num">Spend</th><th class="num">Share</th><th class="num">Impressions</th><th class="num">Results</th></tr>
    </thead>
    <tbody>
      {% for d in demographics %}
      <tr><td>{{ d.age }}</td><td>{{ d.gender }}</td><td class="num">{{ d.spend_fmt }}</td><td class="num">{{ d.pct }}%</td><td class="num">{{ d.impressions }}</td><td class="num">{{ d.results }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if dow_pacing %}
  <div class="two-col">
    <div class="chart">
      <div class="chart-title">Spend by Day of Week</div>
      {% for d in dow_pacing %}
      <div class="hbar-row">
        <div class="hbar-label" style="width:80px">{{ d.label }}</div>
        <div class="hbar-track"><div class="hbar-fill" style="width: {{ d.bar_width | default(0) }}%"></div></div>
        <div class="hbar-val" style="width:70px">{{ d.spend_fmt }} &middot; {{ d.pct }}%</div>
      </div>
      {% endfor %}
    </div>
    <div class="chart">
      <div class="chart-title">Spend by Hour of Day (Audience TZ)</div>
      {% for h in hour_pacing %}
      <div class="hbar-row">
        <div class="hbar-label" style="width:34px">{{ h.label }}h</div>
        <div class="hbar-track"><div class="hbar-fill alt" style="width: {{ h.bar_width | default(0) }}%"></div></div>
        <div class="hbar-val" style="width:70px">{{ h.spend_fmt }} &middot; {{ h.pct }}%</div>
      </div>
      {% endfor %}
    </div>
  </div>
  <p class="small muted">Pacing uses Meta's hourly stats aggregated by audience time zone (day 0 = Sunday).</p>
  {% endif %}

  {% if top_adsets %}
  <h3 class="block">Top Adsets by Spend</h3>
  <table>
    <thead>
      <tr><th>Adset</th><th>Campaign</th><th class="num">Spend</th><th class="num">Results</th><th class="num">CPR</th><th class="num">Impressions</th></tr>
    </thead>
    <tbody>
      {% for a in top_adsets %}
      <tr><td>{{ a.adset_name }}</td><td>{{ a.campaign_name }}</td><td class="num">{{ a.spend_fmt | default(a.spend) }}</td><td class="num">{{ a.results }}</td><td class="num">{{ a.cpr_fmt | default(a.cost_per_result) }}</td><td class="num">{{ a.impressions_fmt | default(a.impressions) }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endif %}

<!-- ================= PAGE & INSTAGRAM ================= -->
{% if 'page_instagram' in sections and (reach | default([]) or messaging | default([]) or content | default([]) or audience | default([])) %}
<div class="page">
  <h2 class="section">Page &amp; Instagram</h2>

  {% for platform in reach %}
  <h3 class="block">Reach &mdash; {{ platform.name }}</h3>
  <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    {% for card in platform.cards %}
    <div class="kpi-card"><div class="label">{{ card.label }}</div><div class="value">{{ card.value }}</div></div>
    {% endfor %}
  </div>
  <div class="util-wrap">
    <div class="util-label">
      <span>Organic vs Paid views</span>
      <span><strong>{{ platform.organic_pct }}%</strong> organic &middot; <strong>{{ platform.paid_pct }}%</strong> paid</span>
    </div>
    <div class="util-track">
      <div class="util-fill" style="width: {{ platform.organic_pct }}%; background: var(--brand); border-radius:7px 0 0 7px;"></div>
    </div>
  </div>
  {% if platform.followers %}
  <p class="small muted">Followers: {{ platform.followers }}{% if platform.followers_delta %} (+{{ platform.followers_delta }} this month){% endif %}</p>
  {% endif %}
  {% endfor %}

  {% if messaging %}
  <h3 class="block">Messaging</h3>
  <table>
    <thead><tr><th>Platform</th><th class="num">Total Contacts</th><th class="num">Conversations Started</th></tr></thead>
    <tbody>
      {% for m in messaging %}
      <tr><td>{{ m.name }}</td><td class="num">{{ m.total_contacts }}</td><td class="num">{{ m.conversations }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if content %}
  {% for platform in content %}
  <h3 class="block">Top Content &mdash; {{ platform.name }}</h3>
  <table>
    <thead><tr><th>Content</th><th>Published</th><th class="num">Views</th><th class="num">Reach</th></tr></thead>
    <tbody>
      {% for row in platform.top %}
      <tr><td>{{ row.title }}</td><td>{{ row.date }}</td><td class="num">{{ row.views }}</td><td class="num">{{ row.reach }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
  {% endif %}

  {% for platform in audience %}
  <h3 class="block">Audience &mdash; {{ platform.name }}</h3>
  <p class="small">Followers: <strong>{{ platform.followers }}</strong>{% if platform.followers_delta %} (+{{ platform.followers_delta }} this month){% endif %}</p>
  {% if platform.geo %}
  <table>
    <thead><tr><th>Country</th><th class="num">Followers</th></tr></thead>
    <tbody>
      {% for row in platform.geo %}
      <tr><td>{{ row.country }}</td><td class="num">{{ row.value }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endfor %}
</div>
{% endif %}

<!-- ================= RECOMMENDATIONS ================= -->
{% if 'recommendations' in sections and (recommendations | default([])) %}
<div class="page">
  <h2 class="section">Recommendations</h2>
  <div class="rec-box">
    <strong style="color: var(--accent-dim); text-transform: uppercase; letter-spacing: 1px;">Priority Actions for Next Month</strong>
    <ol>
      {% for r in recommendations %}<li>{{ r }}</li>{% endfor %}
    </ol>
  </div>
  {% if manual_recommendations %}
  <h3 class="block">Account Manager Notes</h3>
  <ul class="prose" style="padding-left:20px; margin:0;">
    {% for r in manual_recommendations %}<li>{{ r }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

<!-- ================= APPENDIX ================= -->
{% if 'appendix' in sections %}
<div class="page appendix">
  <h2 class="section">Appendix</h2>

  <h3 class="block">Methodology</h3>
  <p class="small">
    All Meta figures come from the Facebook Marketing API (facebook-business SDK {{ 'v25' }}), Ads Insights endpoint at campaign and adset level,
    attributed with Meta's unified attribution setting for the period {{ date_start | default('') }} &mdash; {{ date_stop | default('') }}.
    Money figures are reported as delivered spend in {{ currency | default('EGP') }}. Results reflect each campaign's optimization goal
    (leads, messages, purchases, etc.). "Results" equals the account's primary optimization event; cost-per-result is derived from spend divided by results.
  </p>
  <p class="small">
    Distribution and audience breakdowns are campaign-level insights with Meta breakdown dimensions
    (publisher platform, device platform, country, age/gender, hourly stats by audience time zone).
    Where a breakdown was unavailable for the account, the section is omitted rather than estimated.
  </p>

  <h3 class="block">Data Sources</h3>
  <table>
    <thead><tr><th>Section</th><th>Source</th></tr></thead>
    <tbody>
      <tr><td>Campaign / adset performance, conversions, distribution, audience</td><td>Meta Ads Insights API</td></tr>
      <tr><td>Page reach, followers, content</td><td>Facebook Page Insights API</td></tr>
      <tr><td>Instagram reach, followers, content</td><td>Instagram Graph Insights API</td></tr>
      <tr><td>Budget, VAT, scope notes</td><td>Manual inputs (account manager)</td></tr>
    </tbody>
  </table>

  <h3 class="block">Attribution Note</h3>
  <p class="small">
    Attribution is subject to Meta's default attribution windows for each objective. Cross-channel lift or offline
    conversions are not included. Figures may not sum exactly to totals due to rounding and platform-level deduplication.
  </p>

  <h3 class="block">Manual Inputs Used</h3>
  <table>
    <thead><tr><th>Item</th><th class="num">Value</th></tr></thead>
    <tbody>
      <tr><td>Monthly Budget</td><td class="num">{{ budget.amount | default('-') }}</td></tr>
      <tr><td>Spend (manual)</td><td class="num">{{ budget.spent | default('-') }}</td></tr>
      <tr><td>VAT</td><td class="num">{{ budget.vat | default('-') }}</td></tr>
      <tr><td>Remaining</td><td class="num">{{ budget.remaining | default('-') }}</td></tr>
      {% if revenue is defined and revenue is not none %}<tr><td>Revenue</td><td class="num">{{ revenue_fmt | default('-') }}</td></tr>{% endif %}
    </tbody>
  </table>

  {% if manual_insights %}
  <h3 class="block">Insight Notes</h3>
  <ul class="small" style="padding-left:18px;">
    {% for line in manual_insights %}<li>{{ line }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if report_notes %}
  <h3 class="block">Report Notes</h3>
  <table>
    {% for key, value in report_notes.items() %}
    <tr><td>{{ key | replace('_', ' ') | title }}</td><td>{{ value }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  <p class="small muted" style="margin-top:16px">
    Prepared by Traffic Digital Solutions &middot; Confidential &middot; {{ report_date | default('') }}
  </p>
</div>
{% endif %}

</body>
</html>
