<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% include '_styles.html.j2' %}
<style>
  @page dark {
    size: 10in 7.5in;
    margin: 0;
    background: #171414;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; border: 0; }
    @bottom-right { content: ""; }
  }
  .ref-page { min-height: 160mm; padding-top: 0; }
  .ref-page::before { display: none !important; }
  .ref-head { display: flex; align-items: center; gap: 13mm; margin-bottom: 13mm; }
  .ref-mark { width: 24mm; height: 8.5mm; object-fit: contain; }
  .ref-nav { display: flex; align-items: center; gap: 7mm; color: #747474; font-size: 9pt; white-space: nowrap; }
  .ref-nav span.active { color: #171414; font-weight: 700; border: 1.5px solid #DFA629; border-radius: 50%; padding: 2.5mm 4mm; }
  .ref-title { margin: 0; color: #171414; font-size: 27pt; line-height: 1; text-transform: uppercase; }
  .ref-subtitle { margin: 3mm 0 8mm 0; font-size: 14pt; }
  .ref-subtitle strong { display: inline-block; min-width: 32mm; font-weight: 400; }
  .ref-hand { color: #DFA629; font-family: 'Reenie Beanie'; font-size: 23pt; line-height: .8; }
  .ref-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4mm; margin: 7mm 0; }
  .ref-card { border: 1px solid #E1E1E1; border-top: 2px solid #FCB900; padding: 4mm; }
  .ref-card .label { color: #747474; font-size: 8pt; text-transform: uppercase; }
  .ref-card .value { margin-top: 1mm; color: #171414; font-size: 19pt; font-weight: 600; }
  .ref-note { font-size: 11pt; line-height: 1.55; }
  .ref-page table { font-size: 9pt; }
  .ref-page th { font-size: 8.5pt; }
  .budget-grid { width: 128mm; margin: 18mm 0 0 8mm; font-size: 22pt; }
  .budget-row { display: grid; grid-template-columns: 45mm 1fr; border-bottom: 2px solid #171414; padding: 4mm 0; }
  .budget-row:last-child { border-bottom: 0; }
  .insight-list { margin: 8mm 0 0 0; padding-left: 7mm; font-size: 11pt; line-height: 1.35; }
  .insight-list li { margin-bottom: 3.5mm; }
  .contents-page { page: dark; width: 254mm; height: 190.5mm; padding: 14mm 16mm; color: #FFFFFF; background: #171414; }
  .contents-page::before { display: none !important; }
  .contents-page .ref-mark { content: url('assets/company/image6.png'); }
  .contents-title { margin: 15mm 0 15mm 0; font-size: 28pt; }
  .contents-grid { display: grid; grid-template-columns: 1fr 1.6fr 22mm; gap: 5mm 8mm; font-size: 18pt; font-weight: 700; }
  .contents-line { border-bottom: 1px solid #DFA629; }
  .contents-page-number { font-size: 12pt; font-weight: 400; }
  .thank-title { margin-top: 72mm; font-size: 38pt; font-style: italic; line-height: 1.05; }
  .ref-scope { margin-top: 12mm; font-size: 15pt; line-height: 1.5; }
  [dir="rtl"] { font-family: 'Alexandria'; }
</style>
</head>
<body>

{% macro nav(active) -%}
<div class="ref-head">
  <img class="ref-mark" src="assets/company/image8.png" alt="Traffic">
  <div class="ref-nav">
    {% for item in ['REPORT SCOPE', 'REACH', 'MESSAGING', 'CONTENT', 'AUDIENCE', 'ADS', 'INSIGHTS'] %}
    <span class="{% if item == active %}active{% endif %}">{{ item }}</span>
    {% endfor %}
  </div>
</div>
{%- endmacro %}

<!-- Cover -->
<div class="page cover-page">
  <div class="cover">
    <div class="cover-head"><div class="cover-brand">Traffic</div></div>
    <div>
      <div class="cover-kicker">MARKETING<br>REPORT</div>
      <h1 class="cover-title">Client Name: {{ client.name | default('Client') }}</h1>
      <div class="cover-sub">Date: {{ report_date | default('') }}</div>
    </div>
    <div></div>
  </div>
</div>

<!-- What to expect -->
<div class="page contents-page">
  <img class="ref-mark" src="assets/company/image6.png" alt="Traffic">
  <h1 class="contents-title">WHAT TO EXPECT:</h1>
  <div class="contents-grid">
    {% for item in ['REPORT SCOPE', 'REACH', 'MESSAGING', 'CONTENT', 'AUDIENCE', 'ADS', 'INSIGHTS'] %}
    <div>{{ item }}</div><div class="contents-line"></div><div class="contents-page-number">Page</div>
    {% endfor %}
  </div>
</div>

<!-- Report scope -->
<div class="page ref-page">
  {{ nav('REPORT SCOPE') }}
  <h1 class="ref-title">Report Scope</h1>
  <div class="ref-hand">Achievements &amp; Challenges</div>
  <div class="ref-scope">
    <ul>
      {% if scope_prose %}<li>{{ scope_prose }}</li>{% elif executive_summary %}<li>{{ executive_summary }}</li>{% endif %}
      {% if scope_notes %}<li>{{ scope_notes }}</li>{% endif %}
    </ul>
  </div>
</div>

<!-- Reach: fixed Facebook and Instagram pages -->
{% set reach_rows = reach | default([]) %}
{% for platform_name in ['Facebook', 'Instagram'] %}
{% set platform = reach_rows | selectattr('name', 'equalto', platform_name) | first | default({}) %}
<div class="page ref-page">
  {{ nav('REACH') }}
  <h1 class="ref-title">Reach</h1>
  <div class="ref-subtitle"><strong>{{ platform_name }}</strong>{{ date_start }} - {{ date_stop }}</div>
  {% if platform.cards is defined and platform.cards %}
  <div class="ref-cards">
    {% for card in platform.cards %}
    <div class="ref-card"><div class="label">{{ card.label }}</div><div class="value">{{ card.value }}</div></div>
    {% endfor %}
  </div>
  <h3>Organic vs Paid</h3>
  <div class="util-track"><div class="util-fill" style="width: {{ platform.paid_pct | default(0) }}%"></div></div>
  <p class="ref-note">Paid {{ platform.paid_pct | default(0) }}% &middot; Organic {{ platform.organic_pct | default(0) }}%</p>
  {% if platform.followers %}<p class="ref-note">Followers: <strong>{{ platform.followers }}</strong>{% if platform.followers_delta %} (+{{ platform.followers_delta }}){% endif %}</p>{% endif %}
  {% else %}<p class="ref-note muted">No data available from Meta for this platform and reporting period.</p>{% endif %}
</div>
{% endfor %}

<!-- Messaging: fixed Facebook and Instagram pages -->
{% set messaging_rows = messaging | default([]) %}
{% for platform_name in ['Facebook', 'Instagram'] %}
{% set m = messaging_rows | selectattr('name', 'equalto', platform_name) | first | default({}) %}
<div class="page ref-page">
  {{ nav('MESSAGING') }}
  <h1 class="ref-title">Messaging</h1>
  <div class="ref-subtitle"><strong>{{ platform_name }}</strong>{{ date_start }} - {{ date_stop }}</div>
  <h3>Contacts</h3>
  <p class="ref-note">People who messaged your business during this reporting period.</p>
  {% if m.name is defined %}
  <div class="ref-cards" style="grid-template-columns: repeat(2, 1fr); width: 135mm;">
    <div class="ref-card"><div class="label">Total Contacts</div><div class="value">{{ m.total_contacts }}</div></div>
    <div class="ref-card"><div class="label">Messaging Conversations Started</div><div class="value">{{ m.conversations }}</div></div>
  </div>
  {% else %}<p class="ref-note muted">No data available from Meta for this platform and reporting period.</p>{% endif %}
</div>
{% endfor %}

<!-- Content: fixed Facebook and Instagram pages -->
{% set content_rows = content | default([]) %}
{% for platform_name in ['Facebook', 'Instagram'] %}
{% set platform = content_rows | selectattr('name', 'equalto', platform_name) | first | default({}) %}
<div class="page ref-page">
  {{ nav('CONTENT') }}
  <h1 class="ref-title">Content</h1>
  <div class="ref-subtitle"><strong>{{ platform_name }}</strong>{{ date_start }} - {{ date_stop }}</div>
  <h3>All Content</h3>
  {% if platform.top is defined and platform.top %}
  <table>
    <thead><tr><th>Title</th><th>Date Published</th><th class="num">Views</th><th class="num">Reach</th></tr></thead>
    <tbody>
      {% for row in platform.top %}
      <tr><td>{{ row.title }}</td><td>{{ row.date }}</td><td class="num">{{ row.views }}</td><td class="num">{{ row.reach }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="ref-note muted">Page/Instagram access was not granted in Meta Business Settings — organic content data unavailable.</p>{% endif %}
</div>
{% endfor %}

<!-- Audience: fixed Facebook and Instagram pages -->
{% set audience_rows = audience | default([]) %}
{% for platform_name in ['Facebook', 'Instagram'] %}
{% set platform = audience_rows | selectattr('name', 'equalto', platform_name) | first | default({}) %}
<div class="page ref-page">
  {{ nav('AUDIENCE') }}
  <h1 class="ref-title">Audience</h1>
  <div class="ref-subtitle"><strong>{{ platform_name }}</strong>{{ date_start }} - {{ date_stop }}</div>
  {% if platform.followers is defined %}
  <div class="ref-card" style="width:55mm;"><div class="label">Followers</div><div class="value">{{ platform.followers }}</div></div>
  {% if platform.geo %}
  <h3>Top Countries</h3>
  <table style="width:120mm"><thead><tr><th>Country</th><th class="num">Followers</th></tr></thead><tbody>
    {% for row in platform.geo %}<tr><td>{{ row.country }}</td><td class="num">{{ row.value }}</td></tr>{% endfor %}
  </tbody></table>
  {% endif %}
  {% else %}<p class="ref-note muted">Page/Instagram access was not granted in Meta Business Settings — follower data unavailable.</p>{% endif %}
</div>
{% endfor %}

<!-- Ads: fixed Facebook and Instagram pages -->
{% set platform_rows = platforms | default([]) %}
{% for platform_name in ['Facebook', 'Instagram'] %}
{% set p = platform_rows | selectattr('label', 'equalto', platform_name) | first | default({}) %}
<div class="page ref-page">
  {{ nav('ADS') }}
  <h1 class="ref-title">Ads</h1>
  <div class="ref-subtitle"><strong>{{ platform_name }}</strong>{{ date_start }} - {{ date_stop }}</div>
  {% if p.label is defined %}
  <div class="ref-cards">
    <div class="ref-card"><div class="label">Amount Spent</div><div class="value">{{ p.spend_fmt }}</div></div>
    <div class="ref-card"><div class="label">Results</div><div class="value">{{ p.results_fmt }}</div></div>
    <div class="ref-card"><div class="label">Cost Per Result</div><div class="value">{{ p.cpr | round(2) }}</div></div>
    <div class="ref-card"><div class="label">CTR</div><div class="value">{{ p.ctr }}%</div></div>
  </div>
  <table><thead><tr><th>Platform</th><th class="num">Impressions</th><th class="num">Reach</th><th class="num">Share</th></tr></thead>
  <tbody><tr><td>{{ platform_name }}</td><td class="num">{{ p.impressions }}</td><td class="num">{{ p.reach }}</td><td class="num">{{ p.share_pct }}%</td></tr></tbody></table>
  {% else %}<p class="ref-note muted">No advertising data available from Meta for this platform and reporting period.</p>{% endif %}
</div>
{% endfor %}

<!-- Budget -->
<div class="page ref-page">
  {{ nav('ADS') }}
  <h1 class="ref-title">Ads</h1>
  <div class="ref-hand">Budget &amp; Spend Overview</div>
  <div class="budget-grid">
    <div class="budget-row"><span>Budget</span><strong>{{ budget.amount | default('-') }}</strong></div>
    <div class="budget-row"><span>Spent</span><strong>{{ budget.spent | default('-') }}</strong></div>
    <div class="budget-row"><span>VAT</span><strong>{{ budget.vat | default('-') }}</strong></div>
    <div class="budget-row"><span>Remaining</span><strong>{{ budget.remaining | default('-') }}</strong></div>
  </div>
</div>

<!-- Insights -->
<div class="page ref-page">
  {{ nav('INSIGHTS') }}
  <h1 class="ref-title">Insights</h1>
  <ul class="insight-list">
    {% for item in anomalies | default([]) %}<li>{{ item }}</li>{% endfor %}
    {% for item in recommendations | default([]) %}<li>{{ item }}</li>{% endfor %}
    {% for item in manual_recommendations | default([]) %}<li>{{ item }}</li>{% endfor %}
  </ul>
</div>

<!-- Thank you -->
<div class="page contents-page">
  <div class="cover-brand">Traffic</div>
  <div class="thank-title">THANK<br>YOU</div>
  <div style="margin-top:30mm; font-size:18pt;">Client Name: {{ client.name | default('Client') }}<br>Date: {{ report_date | default('') }}</div>
</div>

</body>
</html>
