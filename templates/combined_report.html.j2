<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% include '_styles.html.j2' %}
<style>
  /* Combined-report overrides + extras (reuses report.html.j2 CSS above). */
  @page {
    @bottom-center {
      content: "Combined Media Buying Report";
    }
  }
  .client-block {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    margin: 0 0 14px 0;
    page-break-inside: avoid;
  }
  .client-block h3 {
    margin: 0 0 4px 0;
    color: var(--brand);
    font-size: 12.5pt;
  }
  .client-block .client-sub {
    color: var(--muted);
    font-size: 8.5pt;
    margin-bottom: 8px;
  }
  .kpi-strip.compact { grid-template-columns: repeat(5, 1fr); margin: 6px 0 10px 0; }
  .strip-box .value.small { font-size: 10.5pt; }
  .mom-line { font-size: 8pt; color: var(--muted); margin-top: 2px; }
  .client-summary-table td:first-child { font-weight: 600; color: var(--brand); }
</style>
</head>
<body>

{% set t = totals | default({}) %}
{% set clients = clients | default([]) %}

<!-- ================= COVER ================= -->
<div class="page">
  <div class="cover">
    <div class="cover-head">
      <div class="cover-brand">TRAFFIC DIGITAL SOLUTIONS</div>
      <div class="cover-mark">T</div>
    </div>
    <div>
      <div class="cover-kicker">Combined Media Buying Report</div>
      <h1 class="cover-title" style="margin-top:14px">All Clients</h1>
      <div class="cover-sub">{{ month_label | default('') }} &mdash; Portfolio Performance</div>
      <div class="cover-rule"></div>
      <div class="cover-meta">
        <div><strong>Reporting Period:</strong> {{ month | default('') }}</div>
        <div><strong>Clients Covered:</strong> {{ client_count | default(0) }}</div>
        <div><strong>Prepared by:</strong> Traffic Digital Solutions</div>
        <div class="muted"><strong>Prepared on:</strong> {{ generated_at | default('') }}</div>
      </div>
    </div>
    <div class="cover-foot">
      Confidential &middot; Prepared for Traffic Digital Solutions &middot; Contains commercially sensitive performance data
    </div>
  </div>
</div>

<!-- ================= PORTFOLIO SUMMARY ================= -->
<div class="page">
  <h2 class="section">Portfolio Summary</h2>
  <p class="lead">
    Combined media buying performance across {{ client_count | default(0) }} client(s) for {{ month_label | default('') }}.
  </p>

  <h3 class="block">Key Performance Indicators (All Clients)</h3>
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="label">Total Spend</div>
      <div class="value">{{ t.spend_fmt | default('0') }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">Total Results</div>
      <div class="value">{{ t.results_fmt | default('0') }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">Total Impressions</div>
      <div class="value">{{ t.impressions_fmt | default('0') }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">CTR</div>
      <div class="value">{{ t.ctr | default(0) }}%</div>
    </div>
    <div class="kpi-card">
      <div class="label">Cost Per Result</div>
      <div class="value">{{ t.cpr_fmt | default('0') }}</div>
    </div>
    <div class="kpi-card">
      <div class="label">Budget Utilization</div>
      <div class="value">{{ t.budget_utilization | default(0) }}%</div>
    </div>
  </div>

  <h3 class="block">Client Overview</h3>
  <table>
    <thead>
      <tr>
        <th>Client</th>
        <th class="num">Spend</th>
        <th class="num">Results</th>
        <th class="num">Impressions</th>
        <th class="num">CTR</th>
        <th class="num">CPR</th>
        <th class="num">Budget Util.</th>
      </tr>
    </thead>
    <tbody>
      {% for c in clients %}
      <tr>
        <td>{{ c.name | default(c.client_id) }}</td>
        <td class="num">{{ c.kpis.spend_fmt | default('0') }}</td>
        <td class="num">{{ c.kpis.results_fmt | default('0') }}</td>
        <td class="num">{{ c.kpis.impressions_fmt | default('0') }}</td>
        <td class="num">{{ c.kpis.ctr | default(0) }}%</td>
        <td class="num">{{ c.kpis.cpr_fmt | default('0') }}</td>
        <td class="num">{{ c.kpis.budget_utilization | default(0) }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<!-- ================= PER-CLIENT DETAIL ================= -->
<div class="page">
  <h2 class="section">Client Breakdown</h2>
  {% for c in clients %}
  <div class="client-block">
    <h3>{{ c.name | default(c.client_id) }}</h3>
    <div class="client-sub">Currency: {{ c.currency | default('-') }} &middot; Client ID: {{ c.client_id | default('-') }}</div>

    {% if c.executive_summary %}
    <div class="exec-box">
      <h3>{{ month_label | default('') }} AT A GLANCE</h3>
      <p>{{ c.executive_summary }}</p>
    </div>
    {% endif %}

    <div class="kpi-strip compact">
      <div class="strip-box">
        <div class="label">Spend</div>
        <div class="value small">{{ c.kpis.spend_fmt | default('0') }}</div>
      </div>
      <div class="strip-box">
        <div class="label">Results</div>
        <div class="value small">{{ c.kpis.results_fmt | default('0') }}</div>
      </div>
      <div class="strip-box">
        <div class="label">Impressions</div>
        <div class="value small">{{ c.kpis.impressions_fmt | default('0') }}</div>
      </div>
      <div class="strip-box">
        <div class="label">CTR</div>
        <div class="value small">{{ c.kpis.ctr | default(0) }}%</div>
      </div>
      <div class="strip-box">
        <div class="label">CPR</div>
        <div class="value small">{{ c.kpis.cpr_fmt | default('0') }}</div>
      </div>
    </div>

    {% if c.mom and c.mom.spend %}
    <div class="mom-line">
      MoM: spend
      {% if c.mom.spend.delta_pct is not none %}{{ c.mom.spend.delta_pct }}%{% else %}n/a{% endif %}
      &middot; results
      {% if c.mom.results.delta_pct is not none %}{{ c.mom.results.delta_pct }}%{% else %}n/a{% endif %}
      &middot; cpr
      {% if c.mom.cpr.delta_pct is not none %}{{ c.mom.cpr.delta_pct }}%{% else %}n/a{% endif %}
      &middot; ctr
      {% if c.mom.ctr.delta_pct is not none %}{{ c.mom.ctr.delta_pct }}%{% else %}n/a{% endif %}
    </div>
    {% endif %}

    {% if c.top_campaigns %}
    <h3 class="block">Top Campaigns</h3>
    <table>
      <thead>
        <tr>
          <th>Campaign</th>
          <th class="num">Results</th>
          <th class="num">CPR</th>
          <th class="num">Spend</th>
        </tr>
      </thead>
      <tbody>
        {% for camp in c.top_campaigns %}
        <tr>
          <td>{{ camp.campaign_name | default(camp.campaign_id) }}</td>
          <td class="num">{{ camp.results | default(0) }}</td>
          <td class="num">{{ camp.cost_per_result | default(0) }}</td>
          <td class="num">{{ camp.spend | default(0) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if c.recommendations %}
    <h3 class="block">Recommendations</h3>
    <div class="rec-box">
      <ol>
        {% for r in c.recommendations %}<li>{{ r }}</li>{% endfor %}
      </ol>
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>

</body>
</html>