<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% include '_styles.html.j2' %}
<style>
  @page dark {
    size: 10in 7.5in; margin: 0; background: #171414;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; border: 0; }
    @bottom-right { content: ""; }
  }
  .ref-page { min-height: 160mm; padding-top: 0; }
  .ref-page::before { display: none !important; }
  .ref-head { display:flex; align-items:center; gap:13mm; margin-bottom:13mm; }
  .ref-mark { width:24mm; height:8.5mm; object-fit:contain; }
  .ref-nav { display:flex; gap:12mm; color:#747474; font-size:10pt; }
  .ref-nav .active { color:#171414; font-weight:700; border:1.5px solid #DFA629; border-radius:50%; padding:2.5mm 4mm; }
  .ref-title { margin:0 0 7mm; color:#171414; font-size:27pt; text-transform:uppercase; }
  .ref-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:4mm; margin-bottom:8mm; }
  .ref-card { border:1px solid #E1E1E1; border-top:2px solid #FCB900; padding:4mm; }
  .ref-card .label { color:#747474; font-size:8pt; text-transform:uppercase; }
  .ref-card .value { margin-top:1mm; font-size:18pt; font-weight:600; }
  .dark-page { page:dark; width:254mm; height:190.5mm; padding:14mm 16mm; background:#171414; color:#FFFFFF; }
  .dark-page::before { display:none !important; }
  .thank-title { margin-top:72mm; font-size:38pt; font-style:italic; line-height:1.05; }
</style>
</head>
<body>
{% set t = totals | default({}) %}
{% set clients = clients | default([]) %}

<div class="page cover-page">
  <div class="cover">
    <div class="cover-head"><div class="cover-brand">Traffic</div></div>
    <div>
      <div class="cover-kicker">MARKETING<br>REPORT</div>
      <h1 class="cover-title">All Clients</h1>
      <div class="cover-sub">{{ month_label | default('') }}</div>
    </div>
    <div></div>
  </div>
</div>

<div class="page dark-page">
  <img class="ref-mark" src="assets/company/image6.png" alt="Traffic">
  <h1 style="margin:18mm 0 18mm;font-size:28pt">WHAT TO EXPECT:</h1>
  <div style="font-size:20pt;line-height:2.3">PORTFOLIO SUMMARY<br>ADS OVERVIEW<br>INSIGHTS</div>
</div>

<div class="page ref-page">
  <div class="ref-head"><img class="ref-mark" src="assets/company/image8.png" alt="Traffic"><div class="ref-nav"><span class="active">PORTFOLIO</span><span>ADS</span><span>INSIGHTS</span></div></div>
  <h1 class="ref-title">Portfolio Summary</h1>
  <div class="ref-cards">
    <div class="ref-card"><div class="label">Total Spend</div><div class="value">{{ t.spend_fmt | default('-') }}</div></div>
    <div class="ref-card"><div class="label">Total Results</div><div class="value">{{ t.results_fmt | default('-') }}</div></div>
    <div class="ref-card"><div class="label">Impressions</div><div class="value">{{ t.impressions_fmt | default('-') }}</div></div>
    <div class="ref-card"><div class="label">CTR</div><div class="value">{{ t.ctr | default('-') }}%</div></div>
  </div>
  <table><thead><tr><th>Client</th><th class="num">Spend</th><th class="num">Results</th><th class="num">CTR</th><th class="num">CPR</th></tr></thead><tbody>
  {% for c in clients %}{% if c.kpis %}<tr><td>{{ c.name | default(c.client_id) }}</td><td class="num">{{ c.kpis.spend_fmt | default('-') }}</td><td class="num">{{ c.kpis.results_fmt | default('-') }}</td><td class="num">{{ c.kpis.ctr | default('-') }}%</td><td class="num">{{ c.kpis.cpr_fmt | default('-') }}</td></tr>{% endif %}{% endfor %}
  </tbody></table>
</div>

<div class="page ref-page">
  <div class="ref-head"><img class="ref-mark" src="assets/company/image8.png" alt="Traffic"><div class="ref-nav"><span>PORTFOLIO</span><span class="active">ADS</span><span>INSIGHTS</span></div></div>
  <h1 class="ref-title">Ads</h1>
  <table><thead><tr><th>Client</th><th class="num">Budget Util.</th><th class="num">Impressions</th><th class="num">Results</th></tr></thead><tbody>
  {% for c in clients %}{% if c.kpis %}<tr><td>{{ c.name | default(c.client_id) }}</td><td class="num">{{ c.kpis.budget_utilization | default('-') }}%</td><td class="num">{{ c.kpis.impressions_fmt | default('-') }}</td><td class="num">{{ c.kpis.results_fmt | default('-') }}</td></tr>{% endif %}{% endfor %}
  </tbody></table>
</div>

<div class="page ref-page">
  <div class="ref-head"><img class="ref-mark" src="assets/company/image8.png" alt="Traffic"><div class="ref-nav"><span>PORTFOLIO</span><span>ADS</span><span class="active">INSIGHTS</span></div></div>
  <h1 class="ref-title">Insights</h1>
  {% for c in clients %}{% if c.recommendations %}<h3>{{ c.name | default(c.client_id) }}</h3><ul>{% for r in c.recommendations[:2] %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}{% endfor %}
</div>

<div class="page dark-page">
  <div class="cover-brand">Traffic</div>
  <div class="thank-title">THANK<br>YOU</div>
  <div style="margin-top:30mm;font-size:18pt">Traffic Digital Solutions<br>{{ generated_at | default('') }}</div>
</div>
</body>
</html>
