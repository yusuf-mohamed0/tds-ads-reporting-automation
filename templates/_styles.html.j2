<style>
  /* ═══════════════════════════════════════════════════════════════
     FONT DECLARATIONS — Proxima Nova (Traffic brand)
     ═══════════════════════════════════════════════════════════════ */
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/ProximaNova-Regular.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Semibold.otf') format('opentype');
    font-weight: 600;
    font-style: normal;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Extrabold.otf') format('opentype');
    font-weight: 800;
    font-style: normal;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Thin.otf') format('opentype');
    font-weight: 300;
    font-style: normal;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Black.otf') format('opentype');
    font-weight: 900;
    font-style: normal;
  }

  /* Legacy fonts kept for combined_report compatibility */
  @font-face {
    font-family: 'Avenir Next LT Pro';
    src: url('assets/fonts/AvenirLTStd-Roman.otf') format('opentype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'Avenir Next LT Pro';
    src: url('assets/fonts/AvenirLTStd-Book.otf') format('opentype');
    font-weight: 500;
  }
  @font-face {
    font-family: 'Avenir Next LT Pro';
    src: url('assets/fonts/AvenirLTStd-Medium.otf') format('opentype');
    font-weight: 600;
  }
  @font-face {
    font-family: 'Avenir Next LT Pro';
    src: url('assets/fonts/AvenirLTStd-Light.otf') format('opentype');
    font-weight: 300;
  }
  @font-face {
    font-family: 'Reenie Beanie';
    src: url('assets/fonts/ReenieBeanie-Regular.ttf') format('truetype');
  }

  /* ═══════════════════════════════════════════════════════════════
     PAGE RULES — A4 Portrait (210mm × 297mm)
     ═══════════════════════════════════════════════════════════════ */
  @page {
    size: 210mm 297mm;
    margin: 22mm 20mm 24mm 20mm;
    @bottom-left {
      content: "TRAFFIC";
      font-family: 'Proxima Nova', 'Avenir Next LT Pro', sans-serif;
      font-size: 7.5pt;
      color: #999;
      font-weight: 600;
      letter-spacing: 1px;
    }
    @bottom-center {
      content: "";
    }
    @bottom-right {
      content: counter(page);
      font-family: 'Proxima Nova', 'Avenir Next LT Pro', sans-serif;
      font-size: 7.5pt;
      color: #999;
      font-weight: 400;
    }
  }
  @page cover {
    margin: 0;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; }
    @bottom-right { content: ""; }
  }
  @page toc {
    margin: 0;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; }
    @bottom-right { content: ""; }
  }
  @page thank {
    margin: 0;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; }
    @bottom-right { content: ""; }
  }
  @page tim {
    margin: 0;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; }
    @bottom-right { content: ""; }
  }

  /* ═══════════════════════════════════════════════════════════════
     DESIGN TOKENS
     ═══════════════════════════════════════════════════════════════ */
  :root {
    --brand: #171414;
    --brand-soft: #3D3B3B;
    --accent: #FCB900;
    --accent-dim: #F89D4B;
    --ink: #171414;
    --muted: #838081;
    --line: #E5E5E5;
    --line-light: #F0F0F0;
    --bg-soft: #FAFAFA;
    --white: #FFFFFF;
    --ok: #087F5B;
    --bad: #B42318;
    --warn: #F89D4B;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESET & BASE
     ═══════════════════════════════════════════════════════════════ */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Proxima Nova', 'Avenir Next LT Pro', Helvetica, Arial, sans-serif;
    color: var(--ink);
    font-size: 9.5pt;
    line-height: 1.5;
    background: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  /* ═══════════════════════════════════════════════════════════════
     PAGE WRAPPER
     ═══════════════════════════════════════════════════════════════ */
  .page {
    page-break-after: always;
    position: relative;
    padding: 0 0 2mm 0;
  }
  .page:last-child { page-break-after: auto; }

  /* ═══════════════════════════════════════════════════════════════
     TYPOGRAPHY
     ═══════════════════════════════════════════════════════════════ */
  h2.section {
    color: var(--brand);
    font-size: 20pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    line-height: 1.1;
    border: 0;
    padding: 0;
    margin: 0 0 1.5mm 0;
  }
  h2.section::after {
    content: "";
    display: block;
    width: 12mm;
    height: 2.5px;
    margin-top: 2mm;
    background: var(--accent);
  }
  h3.block {
    color: var(--brand);
    font-size: 10.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2px;
    margin: 5mm 0 2mm 0;
  }
  .lead {
    color: var(--brand-soft);
    font-size: 10pt;
    line-height: 1.6;
    margin: 0 0 4mm 0;
  }
  .muted { color: var(--muted); }
  .small { font-size: 8pt; }
  .mono { font-variant-numeric: tabular-nums; }

  /* ═══════════════════════════════════════════════════════════════
     KPI CARDS
     ═══════════════════════════════════════════════════════════════ */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3mm;
    margin: 3mm 0 5mm 0;
  }
  .kpi-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 2.5px solid var(--accent);
    padding: 3mm 4mm;
    page-break-inside: avoid;
  }
  .kpi-card .label {
    color: var(--muted);
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 600;
  }
  .kpi-card .value {
    font-size: 16pt;
    font-weight: 700;
    color: var(--brand);
    margin-top: 1mm;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .kpi-card .sub {
    font-size: 7pt;
    color: var(--muted);
    margin-top: 0.5mm;
  }
  .kpi-card .delta { font-size: 7pt; margin-top: 1mm; }
  .up { color: var(--ok); }
  .down { color: var(--bad); }
  .flat { color: var(--muted); }

  /* ═══════════════════════════════════════════════════════════════
     TABLES
     ═══════════════════════════════════════════════════════════════ */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 2mm 0 4mm 0;
    font-size: 8pt;
    table-layout: fixed;
  }
  thead { display: table-header-group; }
  th {
    background: var(--white);
    color: var(--brand-soft);
    text-align: left;
    padding: 2mm 2.5mm;
    font-weight: 700;
    font-size: 7pt;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    border-bottom: 1.5px solid #D0D0D0;
    word-wrap: break-word;
  }
  td {
    border-bottom: 1px solid var(--line);
    padding: 1.8mm 2.5mm;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    vertical-align: top;
  }
  tr { page-break-inside: avoid; }
  tr:nth-child(even) td { background: #F7F7F7; }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row-top td { background: #FFF7DB !important; border-left: 3px solid var(--accent); }
  .row-bottom td { background: #F5F5F5 !important; border-left: 3px solid var(--muted); }
  .cell-sub {
    display: block;
    font-size: 6.5pt;
    color: var(--muted);
    font-weight: 400;
    margin-top: 0.3mm;
  }
  .flag { color: var(--bad); font-size: 7pt; font-weight: 600; }

  /* Share bar in cells */
  .share { display: flex; align-items: center; gap: 2mm; }
  .share-track { flex: 1; height: 3mm; border-radius: 1.5mm; background: var(--line); overflow: hidden; }
  .share-fill { height: 100%; background: var(--accent); border-radius: 1.5mm; }

  /* ═══════════════════════════════════════════════════════════════
     CSS BAR CHARTS
     ═══════════════════════════════════════════════════════════════ */
  .chart { margin: 3mm 0; }
  .chart-title {
    font-size: 8.5pt;
    font-weight: 700;
    color: var(--brand);
    margin: 0 0 2mm 0;
    text-transform: uppercase;
    letter-spacing: 0.2px;
  }
  .hbar-row {
    display: flex;
    align-items: center;
    margin: 1.2mm 0;
    font-size: 7.5pt;
  }
  .hbar-label {
    width: 30mm;
    color: var(--ink);
    flex-shrink: 0;
    font-weight: 500;
  }
  .hbar-track {
    flex: 1;
    height: 3.5mm;
    border-radius: 1.75mm;
    background: var(--line);
    overflow: hidden;
  }
  .hbar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 1.75mm;
  }
  .hbar-fill.alt { background: var(--brand); }
  .hbar-val {
    width: 28mm;
    text-align: right;
    color: var(--muted);
    font-size: 7pt;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    padding-left: 2mm;
  }

  /* ═══════════════════════════════════════════════════════════════
     CALLOUTS
     ═══════════════════════════════════════════════════════════════ */
  .exec-box {
    background: var(--brand);
    color: #F0F0F0;
    border: 0;
    border-left: 4px solid var(--accent);
    padding: 4mm 5mm;
    margin: 3mm 0;
    page-break-inside: avoid;
  }
  .exec-box h3 {
    margin: 0 0 2mm 0;
    color: var(--accent);
    font-size: 9pt;
    letter-spacing: 0.5px;
  }
  .exec-box p {
    margin: 0;
    font-size: 8.5pt;
    line-height: 1.55;
  }
  .rec-box {
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    background: var(--white);
    padding: 3mm 4mm;
    page-break-inside: avoid;
    margin-bottom: 2.5mm;
  }
  .rec-box ol { margin: 1.5mm 0 0 0; padding-left: 5mm; }
  .rec-box li { margin: 1.5mm 0; font-size: 8.5pt; line-height: 1.45; }
  .anomaly-box {
    border: 1px solid var(--line);
    border-left: 4px solid var(--warn);
    background: var(--white);
    padding: 3mm 4mm;
    margin-bottom: 3mm;
  }
  .anomaly-box ul { margin: 1.5mm 0 0 0; padding-left: 5mm; }
  .anomaly-box li { font-size: 8pt; margin: 1mm 0; color: var(--brand-soft); line-height: 1.4; }
  .prose {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    padding: 3mm 4mm;
    color: var(--ink);
    line-height: 1.55;
    font-size: 8.5pt;
  }

  /* ═══════════════════════════════════════════════════════════════
     BUDGET UTILIZATION
     ═══════════════════════════════════════════════════════════════ */
  .util-wrap { margin: 3mm 0; }
  .util-label {
    display: flex;
    justify-content: space-between;
    font-size: 8pt;
    margin-bottom: 1mm;
  }
  .util-track {
    height: 4mm;
    border-radius: 2mm;
    background: var(--line);
    overflow: hidden;
  }
  .util-fill {
    height: 100%;
    border-radius: 2mm;
    background: var(--accent);
  }
  .util-fill.over { background: var(--bad); }

  /* ═══════════════════════════════════════════════════════════════
     BADGES
     ═══════════════════════════════════════════════════════════════ */
  .badge {
    display: inline-block;
    background: var(--brand);
    color: #fff;
    padding: 0.3mm 2mm;
    font-size: 6.5pt;
    font-weight: 700;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }
  .badge.top { background: var(--ok); }
  .badge.bottom { background: var(--muted); }

  /* ═══════════════════════════════════════════════════════════════
     TWO-COLUMN LAYOUT
     ═══════════════════════════════════════════════════════════════ */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
  .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4mm; }
</style>
