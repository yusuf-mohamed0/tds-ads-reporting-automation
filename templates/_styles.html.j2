<style>
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/ProximaNova-Regular.otf') format('opentype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Semibold.otf') format('opentype');
    font-weight: 600;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Bold.otf') format('opentype');
    font-weight: 700;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('assets/fonts/Proxima Nova Black.otf') format('opentype');
    font-weight: 900;
  }
  @font-face {
    font-family: 'Reenie Beanie';
    src: url('assets/fonts/ReenieBeanie-Regular.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Alexandria';
    src: url('assets/fonts/Alexandria-Regular.ttf') format('truetype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'Alexandria';
    src: url('assets/fonts/Alexandria-Bold.ttf') format('truetype');
    font-weight: 700;
  }
  @page {
    size: 10in 7.5in;
    margin: 15mm 12mm 14mm 12mm;
    @bottom-left {
      content: "TRAFFIC";
      font-family: 'Proxima Nova';
      font-size: 8pt; color: #171414;
    }
    @bottom-center {
      content: "";
      font-family: 'Proxima Nova';
      border-top: 1px solid #231F20;
    }
    @bottom-right {
      content: counter(page);
      font-family: 'Proxima Nova';
      font-size: 8pt; color: #747474;
    }
  }
  @page:first {
    margin: 0;
    background: #171414;
    @bottom-left { content: ""; }
    @bottom-center { content: ""; border: 0; }
    @bottom-right { content: ""; }
  }
  :root {
    --brand: #171414;
    --brand-soft: #231F20;
    --accent: #FCB900;
    --accent-dim: #DFA629;
    --ink: #171414;
    --muted: #747474;
    --line: #E9E9E9;
    --bg-soft: #F5F5F5;
    --ok: #087F5B;
    --bad: #B42318;
    --warn: #DFA629;
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'Proxima Nova';
    color: var(--ink); margin: 0; font-size: 10pt; line-height: 1.45;
  }
  .page { page-break-after: always; }
  .page:last-child { page-break-after: auto; }

  /* ---------- Cover ---------- */
  .cover { display: flex; flex-direction: column; justify-content: space-between; height: 161mm; }
  .cover-head { display: flex; justify-content: space-between; align-items: center; }
  .cover-brand { color: var(--brand); font-weight: 800; letter-spacing: 2px; font-size: 11pt; }
  .cover-mark {
    width: 52px; height: 52px; border-radius: 12px; background: var(--brand);
    color: var(--accent); font-weight: 900; font-size: 20pt;
    display: flex; align-items: center; justify-content: center;
  }
  .cover-title { color: var(--brand); font-size: 27pt; font-weight: 800; line-height: 1.1; margin: 0 0 8px 0; }
  .cover-kicker {
    display: inline-block; background: var(--accent); color: var(--brand);
    font-weight: 800; letter-spacing: 1.5px; font-size: 9.5pt;
    padding: 4px 10px; border-radius: 4px; text-transform: uppercase;
  }
  .cover-sub { color: var(--muted); font-size: 13pt; margin-top: 10px; }
  .cover-rule { width: 70px; height: 4px; background: var(--accent); border-radius: 2px; margin: 18px 0; }
  .cover-meta { margin-top: 8px; }
  .cover-meta div { font-size: 11pt; margin: 3px 0; color: var(--ink); }
  .cover-meta .muted { color: var(--muted); }
  .cover-foot {
    border-top: 2px solid var(--brand); padding-top: 10px;
    color: var(--muted); font-size: 8.5pt;
  }

  /* ---------- Section headers ---------- */
  h2.section {
    color: var(--brand); font-size: 15pt; font-weight: 800;
    border-bottom: 3px solid var(--accent); padding-bottom: 4px; margin: 0 0 12px 0;
  }
  h3.block { color: var(--brand); font-size: 11.5pt; margin: 16px 0 6px 0; }
  .lead { color: #09060B; font-size: 10.5pt; line-height: 1.6; margin: 0 0 14px 0; }
  .muted { color: var(--muted); }
  .small { font-size: 8.5pt; }

  /* ---------- KPI dashboard ---------- */
  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 4px 0 10px 0; }
  .kpi-card {
    background: var(--bg-soft); border: 1px solid var(--line);
    border-radius: 8px; padding: 9px 11px; page-break-inside: avoid;
  }
  .kpi-card .label { color: var(--muted); font-size: 7.5pt; text-transform: uppercase; letter-spacing: .5px; }
  .kpi-card .value { font-size: 16pt; font-weight: 800; color: var(--brand); margin-top: 2px; font-variant-numeric: tabular-nums; }
  .kpi-card .delta { font-size: 8pt; margin-top: 2px; }
  .kpi-card .sub { font-size: 8pt; color: var(--muted); margin-top: 2px; }
  .up { color: var(--ok); }
  .down { color: var(--bad); }
  .flat { color: var(--muted); }

  /* Budget utilization */
  .util-wrap { margin: 10px 0 4px 0; }
  .util-label { display: flex; justify-content: space-between; font-size: 9pt; margin-bottom: 4px; }
  .util-track { height: 14px; border-radius: 7px; background: #F3EBF5; overflow: hidden; }
  .util-fill { height: 100%; border-radius: 7px; background: var(--accent-dim); }
  .util-fill.over { background: var(--bad); }

  /* ---------- Tables ---------- */
  table { width: 100%; border-collapse: collapse; margin: 4px 0 12px 0; font-size: 8.2pt; table-layout: fixed; }
  thead { display: table-header-group; }
  th {
    background: var(--brand); color: #fff; text-align: left; padding: 5px 6px;
    font-weight: 600; font-size: 7.8pt; letter-spacing: .2px; word-wrap: break-word;
  }
  td { border-bottom: 1px solid var(--line); padding: 4px 6px; word-wrap: break-word; overflow-wrap: anywhere; }
  tr { page-break-inside: avoid; }
  tr:nth-child(even) td { background: var(--bg-soft); }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .row-top td { background: #F3EBF5; border-left: 3px solid #8109F5; }
  .row-bottom td { background: #F3EBF5; border-left: 3px solid #B93CFC; }
  .flag { color: var(--bad); font-size: 7.8pt; }
  .cell-sub { display: block; font-size: 6.8pt; color: var(--muted); font-weight: 400; }

  /* Share-of-spend bar inside table cells */
  .share { display: flex; align-items: center; gap: 6px; }
  .share-track { flex: 1; height: 8px; border-radius: 4px; background: #F3EBF5; overflow: hidden; }
  .share-fill { height: 100%; background: var(--accent-dim); border-radius: 4px; }

  /* ---------- CSS bar charts ---------- */
  .chart { margin: 6px 0 14px 0; }
  .chart-title { font-size: 9.5pt; font-weight: 700; color: var(--brand); margin: 0 0 6px 0; }
  .hbar-row { display: flex; align-items: center; margin: 3px 0; font-size: 8.5pt; }
  .hbar-label { width: 105px; color: #09060B; flex-shrink: 0; }
  .hbar-track { flex: 1; height: 11px; border-radius: 5px; background: #F3EBF5; overflow: hidden; }
  .hbar-fill { height: 100%; background: var(--accent-dim); border-radius: 5px; }
  .hbar-fill.alt { background: var(--brand); }
  .hbar-val { width: 110px; text-align: right; color: var(--muted); font-size: 7.5pt; flex-shrink: 0; font-variant-numeric: tabular-nums; }

  /* Conversions */
  .conv-bars { margin-top: 6px; }
  .conv-bar-row { display: flex; align-items: center; margin: 2px 0; font-size: 8.3pt; }
  .conv-bar-label { width: 130px; flex-shrink: 0; }
  .conv-bar-track { flex: 1; height: 10px; background: #F3EBF5; border-radius: 5px; overflow: hidden; }
  .conv-bar-fill { height: 100%; background: var(--brand); border-radius: 5px; }
  .conv-bar-val { width: 60px; text-align: right; flex-shrink: 0; font-variant-numeric: tabular-nums; }

  /* ---------- Callouts ---------- */
  .exec-box {
    background: linear-gradient(135deg, var(--brand), var(--brand-soft));
    color: #f8fafc; border-radius: 10px; padding: 16px 18px; margin: 4px 0 14px 0;
    page-break-inside: avoid;
  }
  .exec-box h3 { margin: 0 0 6px 0; color: var(--accent); font-size: 11pt; letter-spacing: 1px; }
  .exec-box p { margin: 0; font-size: 10pt; line-height: 1.65; }
  .rec-box {
    border: 1px solid var(--accent-dim); border-left: 5px solid var(--accent-dim);
    background: #F3EBF5; border-radius: 8px; padding: 12px 16px;
    page-break-inside: avoid;
  }
  .rec-box ol { margin: 6px 0 0 0; padding-left: 18px; }
  .rec-box li { margin: 6px 0; font-size: 9.5pt; }
  .anomaly-box { border: 1px solid #B93CFC; background: #F3EBF5; border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; }
  .anomaly-box ul { margin: 4px 0 0 0; padding-left: 18px; }
  .anomaly-box li { font-size: 9pt; margin: 3px 0; color: #8109F5; }

  /* ---------- Misc ---------- */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .prose { background: var(--bg-soft); border-left: 4px solid var(--accent); padding: 10px 12px; color: #09060B; line-height: 1.55; border-radius: 0 6px 6px 0; }
  .kpi-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 8px 0; }
  .strip-box { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; text-align: center; }
  .strip-box .label { font-size: 7.5pt; color: var(--muted); text-transform: uppercase; letter-spacing: .4px; }
  .strip-box .value { font-size: 12.5pt; font-weight: 800; color: var(--brand); margin-top: 3px; }
  .toc-line { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dotted var(--line); font-size: 11pt; }
  .toc-num { color: var(--accent-dim); font-weight: 800; margin-right: 8px; }
  .appendix h3 { margin-top: 16px; }
  .badge { display: inline-block; background: var(--brand); color: #fff; border-radius: 3px; padding: 1px 6px; font-size: 7.5pt; font-weight: 700; }
  .badge.top { background: var(--ok); }
  .badge.bottom { background: var(--bad); }
  .delta-arrow { font-weight: 700; }

  /* Official TRAFFIC report template. Keep this layer aligned with the
     immutable source files in assets/company-report-template/. */
  body { background: #FFFFFF; }
  .page { position: relative; min-height: 160mm; padding-top: 8mm; }
  .page:not(.cover-page)::before {
    content: "";
    position: absolute; top: 0; left: 0;
    width: 25mm; height: 9mm;
    background: url("assets/company/image8.png") left top / contain no-repeat;
  }
  .page:not(.cover-page) > h2.section::before {
    content: "REPORT SCOPE     REACH     MESSAGING     CONTENT     AUDIENCE     ADS     INSIGHTS";
    display: block;
    margin: -5mm 0 7mm 28mm;
    color: #747474;
    font-size: 8.2pt;
    font-weight: 400;
    letter-spacing: .2px;
    white-space: pre;
  }
  .page:not(.cover-page) > h2.section {
    border: 0;
    padding: 0;
    margin: 0 0 5mm 0;
    color: #171414;
    font-size: 24pt;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -.5px;
  }
  .page:not(.cover-page) > h2.section::after {
    content: "";
    display: inline-block;
    width: 11mm;
    height: 3px;
    margin-left: 3mm;
    vertical-align: middle;
    background: #FCB900;
  }

  .cover-page {
    margin: 0;
    padding: 0;
    width: 254mm;
    height: 190.5mm;
    min-height: 0;
    overflow: hidden;
    background: #171414 url("assets/company/image2.png") center / cover no-repeat;
    color: #FFFFFF;
  }
  .cover-page .cover { height: 190.5mm; padding: 13mm 15mm 12mm 15mm; }
  .cover-head { align-items: flex-start; }
  .cover-brand {
    color: #FFFFFF;
    font-size: 27pt;
    font-weight: 900;
    letter-spacing: -2px;
    text-transform: none;
  }
  .cover-brand::after { content: "."; color: #FCB900; }
  .cover-mark { display: none; }
  .cover-kicker {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #FFFFFF;
    font-size: 28pt;
    font-style: italic;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0;
  }
  .cover-title { color: #FFFFFF; font-size: 20pt; font-weight: 500; margin-top: 12mm !important; }
  .cover-sub { color: #FFFFFF; font-size: 13pt; }
  .cover-rule { width: 42mm; height: 2px; border-radius: 0; background: #FCB900; }
  .cover-meta div, .cover-meta .muted { color: #FFFFFF; }
  .cover-foot { border-color: #FCB900; color: #E9E9E9; }

  h3.block { color: #171414; font-size: 12pt; text-transform: uppercase; }
  .lead { color: #231F20; }
  .kpi-card, .strip-box, .client-block {
    border: 1px solid #E1E1E1;
    border-radius: 0;
    background: #FFFFFF;
  }
  .kpi-card { border-top: 3px solid #FCB900; }
  .kpi-grid { gap: 6px; }
  .kpi-card { padding: 4px 7px; }
  .kpi-card .value { font-size: 13pt; }
  .kpi-card .value, .strip-box .value { color: #171414; }
  table { border-top: 1px solid #D8D8D8; }
  th {
    background: #FFFFFF;
    color: #231F20;
    border-bottom: 1px solid #D8D8D8;
    font-weight: 700;
  }
  td { border-bottom-color: #E1E1E1; }
  tr:nth-child(even) td { background: #F0F0F0; }
  .row-top td { background: #FFF7DB; border-left-color: #FCB900; }
  .row-bottom td { background: #F5F5F5; border-left-color: #747474; }
  .share-track, .hbar-track, .conv-bar-track, .util-track { background: #E9E9E9; }
  .share-fill, .hbar-fill, .util-fill { background: #FCB900; }
  .hbar-fill.alt, .conv-bar-fill { background: #231F20; }
  .exec-box {
    border-radius: 0;
    border-left: 5px solid #FCB900;
    background: #171414;
  }
  .exec-box { padding: 9px 12px; margin-bottom: 7px; }
  .exec-box p { font-size: 9pt; line-height: 1.5; }
  h3.block { margin-top: 10px; margin-bottom: 4px; }
  .exec-box h3 { color: #FCB900; }
  .rec-box, .anomaly-box, .prose {
    border: 1px solid #E1E1E1;
    border-left: 4px solid #FCB900;
    border-radius: 0;
    background: #FFFFFF;
  }
  .anomaly-box li { color: #231F20; }
  .badge, .badge.top { background: #171414; }
  .badge.bottom { background: #747474; }
  .toc-line { border-color: #D8D8D8; }
  .toc-num { color: #DFA629; }
</style>
