# App
APP_ENV=local
TIMEZONE=Africa/Cairo
REPORT_RECIPIENT=reports@trafficdigitalsolutions.com

# Meta Marketing API (ads insights)
# System User token with ads_read permission. See docs/03-meta-api-setup.md
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v26.0

# Meta Page / Instagram insights token
# Page access token with ANALYZE+CONTENT tasks. Per-client Page ID and
# Instagram Business Account ID live in configs/clients.yaml (meta.page_id / meta.instagram_id)
META_PAGE_ACCESS_TOKEN=

# Email Option A: Gmail API OAuth (recommended)
GMAIL_SENDER=reports@trafficdigitalsolutions.com
GOOGLE_APPLICATION_CREDENTIALS=/root/tds-ads-reporting-automation/gmail_credentials.json
GMAIL_TOKEN_FILE=/root/tds-ads-reporting-automation/gmail_token.json
GMAIL_CLIENT_SECRETS=/root/tds-ads-reporting-automation/gmail_client_secret.json

# Email Option B: SMTP app password (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=1

# Local paths
SQLITE_PATH=./data/reporting.sqlite
REPORTS_DIR=./reports
LOGS_DIR=./logs
