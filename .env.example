# App
APP_ENV=local
TIMEZONE=Africa/Cairo
REPORT_RECIPIENT=reports@trafficdigitalsolutions.com
REPORT_SENDER=

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Meta Page / Instagram insights token
# Must cover every FB Page and IG professional account referenced by client reports
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Email Option A: Gmail API OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Email Option B: SMTP app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# Local paths
SQLITE_PATH=./data/reporting.sqlite
REPORTS_DIR=./reports
LOGS_DIR=./logs
